{varType object $item}
{varType ?int $activeItemId}

{if $item->pageId == null}
<a href="{$item->url}" title="{$item->title}">{$item->name}</a>
{else}
<a href="{plink :FrontModule:Cms: uri => $item->url}" title="{$item->title}" n:class="($activeItemId == $item->id) ? active">{$item->name}</a>
{/if}
