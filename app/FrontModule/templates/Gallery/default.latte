{block #content}
<div class="breadcrumb">
	<ul>
		<li><a title="Úvod" n:href=":Front:Homepage: id => NULL">Úvod</a><span>&gt;</span></li>
		<li><a title="Galerie" n:href=":Front:Gallery: id => NULL" class="active">Galerie</a></li>
	</ul>
	<div class="cleaner"></div>
</div>

<h1 n:block=title>Galerie</h1>


{if $galleries->count()}
	<div class="gallery">
	{foreach $galleries as $gallery}
		{var $item = $presenter->context->createGalleryItems()->where('gallery_id', $gallery->id)->where('active', true)->order('RAND()')->limit(1)->fetch()}
		{if $item}
		<div n:class="item, (($iterator->counter-1) % 3 == 0) ? itemFirst, (($iterator->counter-1) % 3 == 2) ? itemLast">
			<a n:href=":Front:Gallery:detail id => $item['gallery_id']" title="{$gallery['name']}">
				<img src="{$baseUrl}/resources/galleries/gallery_{$item['gallery_id']}/thumb_{$item['file_name']}" alt="{$item['title']}" />
			</a>
			<div class="info">
				<h2><a n:href=":Front:Gallery:detail id => $item['gallery_id']" title="{$gallery['name']}">{$gallery->name}</a></h2>
				<div class="time">{$gallery->added|date:"H:i:s d.m.Y"}</div>
				<p>{$gallery->description|truncate:64}</p>
			</div>
		</div>
		{/if}
	{/foreach}
	</div>
{else}
	<div class="nothingToShow">Nebyly nalezeny žádné galerie</div>
{/if}
