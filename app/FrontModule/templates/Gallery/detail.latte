 * @version     1.0.0
 *}
 
{block #content}
{if $gallery}
<div class="breadcrumb">
	<ul>
		<li><a title="Úvod" n:href=":Front:Homepage: id => NULL">Úvod</a><span>&gt;</span></li>
		<li><a title="Galerie" n:href=":Front:Gallery: id => NULL">Galerie</a><span>&gt;</span></li>
		<li><a title="{$gallery->name}" n:href=":Front:Gallery:detail id => $gallery->id" class="active">{$gallery->name}</a></li>
	</ul>
	<div class="cleaner"></div>
</div>

<h1 n:block=title>{$gallery->name}</h1>

<div class="wysiwyg">
	<p>{$gallery->description}</p>
</div>

{if $galleryItems->count()}
<div class="gallery">
{foreach $galleryItems as $item}
	<div n:class="item, (($iterator->counter-1) % 3 == 0) ? itemFirst, (($iterator->counter-1) % 3 == 2) ? itemLast">
		<a rel="shadowbox[gallery_{$gallery->id}]" href="{$baseUrl}/resources/galleries/gallery_{$gallery->id}/{$item['file_name']}" title="{$item['title']}" longdesc="{$item['description']}">
			<img src="{$baseUrl}/resources/galleries/gallery_{$gallery->id}/thumb_{$item['file_name']}" alt="{$item['title']}" />
		</a>
		<div class="info">
			<h2>{$item->title}</h2>
			<div class="time">{$item->added|date:"H:i:s d.m.Y"}</div>
			<p>{$item->description|truncate:64}</p>
		</div>
	</div>
{/foreach}
</div>

{else}
	<div class="nothingToShow">Nebyly nalezeny žádné obrázky</div>
{/if}

<div class="cleaner"></div>

{if $gallery['allow_comments']}
	{control galleryComments}
{/if}

{/if}