#!/usr/bin/env bash
# Restore a dump (.sql or .sql.gz) into the database, like pg_restore.
# Dumps made by db/dump contain DROP TABLE IF EXISTS, so existing tables
# with the same names are replaced.
#
# Usage: db/restore <dump-file>
set -euo pipefail

cd "$(dirname "$0")/.."
source db/lib/db.sh

file="${1:-}"
if [[ -z "$file" || ! -f "$file" ]]; then
  echo "Usage: db/restore <dump.sql|dump.sql.gz>" >&2
  exit 1
fi

echo "Restoring $file into $DB_NAME"
if [[ "$file" == *.gz ]]; then
  gunzip -c "$file" | mysql_cli
else
  mysql_cli < "$file"
fi
echo "Done."
