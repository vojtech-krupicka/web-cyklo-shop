services:
	database: @Nette\Database\Connection
	- Nette\Utils\FileSystem
	- App\Core\RouterFactory::createRouter
	- App\Presentation\FrontModule\Contact\ContactPresenter(%mapy.apiKey%)
	- App\Core\AdminAuthenticator
	- App\Model\AppSettings(%wwwDir%, %settings.resourcesDir%)
	- App\Model\SeoSettings(%seo.title%, %seo.keywords%, %seo.description%)
	- App\Model\ShopInfo(%shopInfo%, %openingHours%)

search:
	- in: %appDir%
		classes:
			- *Facade
			- *Factory
			- *Repository
			- *Service
