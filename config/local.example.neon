# Copy to config/local.<env>.neon (dev, prod) - those copies are git-ignored.

parameters:
	# Docker dev container: the values come from .env (the same file docker-compose uses),
	# so this works as it is.
	database:
		driver: mysql
		host: %env.DB_HOST%
		dbname: %env.MYSQL_DATABASE%
		user: %env.MYSQL_USER%
		password: %env.MYSQL_PASSWORD%

	# Production without environment variables (e.g. shared hosting): write the values here instead.
	#database:
	#	driver: mysql
	#	host: some-db-server
	#	dbname: db-name
	#	user: db-user
	#	password: db-password

	# Contact page map, see README. Leave empty to show no map tiles.
	mapy:
		apiKey: ''
