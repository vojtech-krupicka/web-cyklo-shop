# Docker and app environment (template: .env.example)
/.env

# Local DI configuration — holds database credentials, must never be committed
/config/local.dev.neon
/config/local.prod.neon

# Writable runtime directories (keep the dir, ignore the contents)
/temp/*
!/temp/.gitignore
!/temp/.htaccess
!/temp/web.config
/log/*
!/log/.gitignore
!/log/.htaccess
!/log/web.config

# PHPUnit test cache
/.phpunit.cache/

# Bundled third-party tools not needed in the repo
# (Adminer = web DB console, Checker = Nette environment checker — both are
#  security-sensitive to ship and are easy to re-download if ever needed)
/www/adminer/
/www/checker/

# Uploaded content
/www/resources/

# Generated TinyMCE file/image lists
/www/javascript/tinymce.filelist.js
/www/javascript/tinymce.imagelist.js
/www/assets/javascript/tinymce.imagelist.js
/www/assets/javascript/tinymce.filelist.js

# Editors / OS
.idea/
*.swp
.DS_Store
Thumbs.db

/vendor/
/var/mail/*
!/var/mail/.gitkeep
/db/dumps/*
!/db/dumps/.gitkeep

